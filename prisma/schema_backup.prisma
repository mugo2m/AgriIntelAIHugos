  cropId Int
  crop Crop @relation(fields: [cropId], references: [id])

  seasonId Int
  season Season @relation(fields: [seasonId], references: [id])

  year Int

  transactionType CommodityTransactionType

  salesChannelId Int?
  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])

  buyerId Int?
  buyer Buyer? @relation(fields: [buyerId], references: [id])

  quantityKg Float

  pricePerKg Float?

  totalAmount Float?

  // Source Location

  sourceCountryId Int?
  sourceCountry Country? @relation("SourceCountry", fields: [sourceCountryId], references: [id])

  sourceCountyId Int?
  sourceCounty County? @relation("SourceCounty", fields: [sourceCountyId], references: [id])

  sourceSubCountyId Int?
  sourceSubCounty SubCounty? @relation("SourceSubCounty", fields: [sourceSubCountyId], references: [id])

  sourceWardId Int?
  sourceWard Ward? @relation("SourceWard", fields: [sourceWardId], references: [id])

  // Destination Location

  destinationCountryId Int?
  destinationCountry Country? @relation("DestinationCountry", fields: [destinationCountryId], references: [id])

  destinationCountyId Int?
  destinationCounty County? @relation("DestinationCounty", fields: [destinationCountyId], references: [id])

  destinationSubCountyId Int?
  destinationSubCounty SubCounty? @relation("DestinationSubCounty", fields: [destinationSubCountyId], references: [id])

  destinationWardId Int?
  destinationWard Ward? @relation("DestinationWard", fields: [destinationWardId], references: [id])

  transactionDate DateTime

  referenceNumber String?

  remarks String?

  // Link to detailed sale (only for SALE transactions)

  commoditySale CommoditySale?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

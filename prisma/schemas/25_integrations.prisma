model ExternalIntegration {
  id Int @id @default(autoincrement())

  name String

  integrationType IntegrationType

  provider String

  baseUrl String?

  apiVersion String?

  status IntegrationStatus @default(ACTIVE)

  authenticationType String?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  apiKeys ApiKey[]

  logs                   APILog[]
  integrationCredentials IntegrationCredential[]
}

model ApiKey {
  id Int @id @default(autoincrement())

  integrationId Int
  integration   ExternalIntegration @relation(fields: [integrationId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  keyName String

  apiKey String

  expiresAt DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model APILog {
  id Int @id @default(autoincrement())

  integrationId Int
  integration   ExternalIntegration @relation(fields: [integrationId], references: [id])

  endpoint String

  requestMethod String

  requestBody String?

  responseBody String?

  responseCode Int?

  responseTime Float?

  status APILogStatus

  createdAt DateTime @default(now())
}

model Webhook {
  id Int @id @default(autoincrement())

  name String

  endpoint String

  secret String?

  eventType String

  active Boolean @default(true)

  lastTriggered DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model IntegrationCredential {
  id Int @id @default(autoincrement())

  integrationId Int
  integration   ExternalIntegration @relation(fields: [integrationId], references: [id])

  credentialName String

  credentialValue String

  encrypted Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ImportJob {
  id Int @id @default(autoincrement())

  jobName String

  source ImportSource

  fileName String?

  totalRecords Int?

  successfulRecords Int?

  failedRecords Int?

  status ImportStatus @default(PENDING)

  initiatedById Int?
  initiatedBy   User? @relation(fields: [initiatedById], references: [id])

  startedAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())

  validationLogs ImportValidationLog[]
}

model ImportValidationLog {
  id Int @id @default(autoincrement())

  importJobId Int
  importJob   ImportJob @relation(fields: [importJobId], references: [id])

  rowNumber Int?

  fieldName String?

  message String

  severity ValidationSeverity

  createdAt DateTime @default(now())
}

model MigrationJob {
  id Int @id @default(autoincrement())

  migrationName String

  sourceSystem String

  destinationSystem String

  status MigrationStatus @default(PENDING)

  totalRecords Int?

  migratedRecords Int?

  failedRecords Int?

  initiatedById Int?
  initiatedBy   User? @relation(fields: [initiatedById], references: [id])

  startedAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
}

model ExportJob {
  id Int @id @default(autoincrement())

  exportName String

  format ImportSource

  exportedById Int?
  exportedBy   User? @relation(fields: [exportedById], references: [id])

  totalRecords Int?

  filePath String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())

  completedAt DateTime?
}

model ETLJob {
  id Int @id @default(autoincrement())

  jobName String

  extractSource String

  transformationDescription String?

  loadDestination String

  schedule String?

  active Boolean @default(true)

  lastRun DateTime?

  nextRun DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SyncLog {
  id Int @id @default(autoincrement())

  deviceId Int
  device   UserDevice @relation(fields: [deviceId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  entityName String

  entityId Int?

  operation SyncOperation

  status SyncStatus @default(PENDING)

  conflictMessage String?

  startedAt DateTime?

  completedAt DateTime?

  createdAt           DateTime             @default(now())
  conflictResolutions ConflictResolution[]
}

model SyncQueue {
  id Int @id @default(autoincrement())

  entityName String

  entityId Int?

  operation SyncOperation

  payload String

  status SyncStatus @default(PENDING)

  retryCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

